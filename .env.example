# ---------------------------------------------------------------------------
# WiBot - configuración. Copiar a .env y completar. NUNCA commitear .env.
# ---------------------------------------------------------------------------

# --- Base de datos (solo lectura) ------------------------------------------
# Local: apunta al MariaDB levantado por scripts/db-local.sh
# Producción: host/puerto del servidor, o 127.0.0.1 con túnel SSH abierto
#   ssh -N -L 3307:localhost:3306 usuario@cupones.mgcontact.cl
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=wibot
DB_PASSWORD=
DB_NAME=mgcontact_local
# Prefijo de tablas del WordPress de origen
DB_TABLE_PREFIX=3KC870n_
# Socket unix opcional (tiene prioridad sobre host/puerto si se define)
DB_SOCKET=

# --- Límites de consulta ----------------------------------------------------
# Filas máximas devueltas por una consulta libre
QUERY_ROW_LIMIT=500
# Timeout de consulta en milisegundos
QUERY_TIMEOUT_MS=15000

# --- Privacidad -------------------------------------------------------------
# aggregate: agregados libres, datos personales solo en búsquedas puntuales (por defecto)
# masked:    RUT, teléfono y email siempre enmascarados
# full:      sin restricciones (solo uso interno autorizado)
PII_MODE=aggregate

# --- Modelo (Gemini vía API compatible OpenAI) ------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash

# --- Web --------------------------------------------------------------------
# Zona horaria usada para "hoy", "ayer", "este mes"
WIBOT_TIMEZONE=America/Santiago

# --- Control de acceso ------------------------------------------------------
# Archivo SQLite con usuarios, sesiones y auditoría. Separado de la base de MG Contact.
WIBOT_AUTH_DB=.data/wibot.sqlite
# Horas que dura una sesión
WIBOT_SESSION_HOURS=12
# Intentos fallidos antes de bloquear, y minutos que dura el bloqueo
WIBOT_MAX_INTENTOS=5
WIBOT_MINUTOS_BLOQUEO=15
# Largo mínimo de contraseña
WIBOT_LARGO_MINIMO=12
# Poner en 1 cuando WiBot se sirva por HTTPS: marca la cookie de sesión como segura
WIBOT_COOKIE_SEGURA=0

# --- Desarrollo -------------------------------------------------------------
# Poner en 1 para habilitar el registro técnico (/api/diagnostico y el panel del chat).
# Dejar apagado en producción: expone cuerpos de error y argumentos de consulta.
WIBOT_DEV=0
